# ==============================================================================
# swatcher - Enterprise Git Ignore Rules
# ==============================================================================

# Environment & Secrets (NEVER COMMIT SENSITIVE CREDENTIALS)
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database & Storage
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
swatcher-server/data/
data/

# Java & Gradle Build Outputs
.gradle/
build/
bin/
out/
target/
*.class

# Keep Gradle Wrapper JAR for CI/CD builds
!gradle/wrapper/gradle-wrapper.jar
!swatcher-extension/gradle/wrapper/gradle-wrapper.jar

# Burp Suite Engagement Files & Temporary Captures
*.burp
*.burp.*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Artifacts
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# General Logs & Dumps
logs/
*.log
*.tmp
*.bak
*.swp
*.swo

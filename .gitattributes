# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit LF for shell scripts (prevents \r: command not found errors on Linux/Kali/WSL)
*.sh text eol=lf
*.bash text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.db binary
